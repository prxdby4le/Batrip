# Batrip E-commerce - Apache Configuration
# Este arquivo configura o sistema para usar o MVC (index-mvc.php)

# Define index-mvc.php como arquivo padrão (prioridade sobre index.php)
DirectoryIndex index-mvc.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Define o diretório base (ajuste se necessário)
    # Para subdiretório: RewriteBase /subpasta/
    # Para raiz (Docker padrão):
    RewriteBase /
    
    # Permite acesso direto a /uploads/ (PRIMEIRA REGRA - antes de tudo)
    # IMPORTANTE: Esta regra deve vir ANTES de todas as outras para não redirecionar para MVC
    # Para qualquer requisição em /uploads/, para o processamento de rewrite imediatamente
    RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
    RewriteRule .* - [L]
    
    # Redireciona acesso direto a index.php para index-mvc.php
    RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
    RewriteRule ^index\.php$ /index-mvc.php [R=301,L]
    
    # Redireciona /produtos/ (com ou sem barra) para o MVC ANTES de verificar diretório físico
    # Isso evita o erro 403 quando existe o diretório físico public/produtos/
    # IMPORTANTE: Esta regra deve vir ANTES das verificações de arquivo/diretório
    RewriteCond %{REQUEST_URI} ^/produtos/?$ [NC]
    RewriteRule .* /index-mvc.php [L]
    
    # Redireciona /adm/ (com ou sem barra) para o MVC ANTES de verificar diretório físico
    # Isso evita o erro 403 quando existe o diretório físico public/adm/
    # IMPORTANTE: Esta regra deve vir ANTES das verificações de arquivo/diretório
    # Arquivos PHP dentro de /adm/ (ex: /adm/index-adm.php) ainda serão acessíveis diretamente
    RewriteCond %{REQUEST_URI} ^/adm/?$ [NC]
    RewriteRule .* /index-mvc.php [L]
    
    # Redireciona subdiretórios de /adm/ para o MVC ANTES de verificar diretório físico
    # Isso evita o erro 403 quando existem diretórios físicos dentro de public/adm/
    # Arquivos PHP dentro desses diretórios ainda serão acessíveis diretamente
    # Padrão: /adm/{subdir}/ sem subcaminhos adicionais
    RewriteCond %{REQUEST_URI} ^/adm/(pedidos|produtos|usuarios|conjuntos)/?$ [NC]
    RewriteRule .* /index-mvc.php [L]
    
    # Redireciona /checkout/ (com ou sem barra) para o MVC ANTES de verificar diretório físico
    # Isso evita o erro 403 quando existe o diretório físico public/checkout/
    # IMPORTANTE: Esta regra deve vir ANTES das verificações de arquivo/diretório
    RewriteCond %{REQUEST_URI} ^/checkout/?$ [NC]
    RewriteRule .* /index-mvc.php [L]
    
    # Redireciona rotas legadas de pedidos para MVC
    RewriteCond %{THE_REQUEST} \s/registros/pedidos\.php[\s?] [NC]
    RewriteRule ^registros/pedidos\.php$ /pedidos [R=301,L]
    
    # Permite acesso direto a arquivos estáticos (CSS, JS, imagens, etc)
    # IMPORTANTE: Verifica se o arquivo existe antes de permitir acesso
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} \.(css|js|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|eot)$ [NC]
    RewriteRule .* - [L]
    
    # BLOQUEIA acesso direto a arquivos PHP legados em /checkout/ e /registros/
    # Força tudo para MVC
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} ^/(checkout|registros)/.*\.php$ [NC]
    RewriteRule .* index-mvc.php [QSA,L]
    
    # Permite acesso direto apenas a arquivos não-PHP existentes (uploads, etc)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} !\.php$ [NC]
    RewriteRule .* - [L]
    
    # Redireciona tudo para front controller MVC mantendo query string
    RewriteRule ^(.*)$ index-mvc.php [QSA,L]
</IfModule>

# Desabilita mod_rewrite para /uploads/ (permite acesso direto)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
    RewriteRule .* - [L]
</IfModule>

# Desabilita listagem de diretórios
Options -Indexes

# Garante MIME types corretos para arquivos JavaScript
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/javascript .js
</IfModule>

# Configurações de segurança
<IfModule mod_headers.c>
    # Previne clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Previne MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    
    # Habilita proteção XSS do navegador
    Header set X-XSS-Protection "1; mode=block"
    
    # Política de referrer
    Header set Referrer-Policy "no-referrer-when-downgrade"

    # Content Security Policy - Permite Bootstrap Icons, Google Fonts, Mercado Pago, etc.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://sdk.mercadopago.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https://www.mercadolibre.com https://www.mercadolivre.com; connect-src 'self' https://viacep.com.br https://api.mercadopago.com https://api.mercadolibre.com https://www.mercadolibre.com https://www.mercadolivre.com https://cdn.jsdelivr.net; frame-src 'self' https://www.mercadopago.com https://www.mercadolibre.com https://www.mercadolivre.com; frame-ancestors 'self';"
</IfModule>

# Proteção de arquivos sensíveis
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Cache de assets
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Imagens
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS e JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fontes
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
